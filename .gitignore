# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# =============================================================================
# Virtual environments — НИКОГДА не коммитим
# =============================================================================
.venv/
venv/
env/
ENV/

# =============================================================================
# Deploy secrets — SSH ключи для CI/CD никогда не коммитим
# =============================================================================
deploy/secrets/

# =============================================================================
# Env / secrets — НИКОГДА не коммитим, шаблоны держим в репо
# =============================================================================
.env
.env.local
.env.staging
.env.prod
.env.*.local
*.pem
*.key
secrets/
!.env.example
!.env.*.example

# =============================================================================
# Временные файлы и артефакты рантайма
# =============================================================================
tmp/
*.tmp
*.log
logs/
# Автономные сессии: логи + динамические промты (всё .log и prompt_*.md внутри)
runs/
voice_cache/
*.ogg
*.mp3
*.wav
*.m4a
# (исключения: если положили семпл в tests/fixtures/, разкомментируй ниже)
# !tests/fixtures/*.ogg

# =============================================================================
# IDE / OS
# =============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
*.iml

# =============================================================================
# Claude Code — settings.local.json коммитим (permissions allowlist для всей
# команды), state/cache/plans — нет.
# Глобальный ~/.config/git/ignore у dev'а может игнорировать .claude/ целиком;
# поэтому явно "размораживаем" нужные файлы через `!`.
# =============================================================================
.claude/state/
.claude/cache/
.claude/plans/
!.claude/
!.claude/settings.local.json

# =============================================================================
# Локальные дампы данных и БД
# =============================================================================
*.sqlite
*.sqlite3
*.db
dumps/

# =============================================================================
# Прочее
# =============================================================================
node_modules/
*.bak
