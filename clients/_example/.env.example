# =============================================================================
# Client env — clients/_example/
# =============================================================================
# Per-client environment variables for the bootstrap entry point:
#
#     python -m core.bootstrap clients/_example
#
# Copy this to `.env` (in the repo root, or load it however your deploy does)
# and fill in the real values. The template config (templates/tg-restaurant/
# config.yaml) only names these variables; secrets live ONLY here, never in
# config.yaml and never committed.
#
# This mirrors the repo-root .env.example — every variable the instance reads.
# =============================================================================

# --- Окружение ---
# local | staging | prod
ENV=local
LOG_LEVEL=INFO

# --- Telegram (два разных бота, отдельные токены) ---
TELEGRAM_GUEST_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_TOKEN=

# Bootstrap-токен для первого админа (см. репо-корневой .env.example).
# Сгенерируй: openssl rand -hex 16
ADMIN_BOOTSTRAP_TOKEN=

# --- OpenAI (один ключ обслуживает chat + Whisper + Embeddings) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_USAGE_TAG=local-dev

# --- Supabase (storage.primary в config.yaml) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Pinecone (storage.vector в config.yaml) ---
PINECONE_API_KEY=
PINECONE_INDEX=client-cards
PINECONE_NAMESPACE=dev

# --- Прочее ---
VOICE_TMP_DIR=./tmp/voice

# --- Контекст ресторана для voice question advisor ---
RESTAURANT_CONTEXT=

# --- HTTP API (admin Mini App backend) ---
# Секрет для подписи admin JWT. Сгенерируй: openssl rand -hex 32
# Пустая строка = API в fail-loud режиме.
MINI_APP_SESSION_SECRET=

# CORS allowlist для Mini App, comma-separated. Никогда не "*".
ALLOWED_MINI_APP_ORIGINS=
