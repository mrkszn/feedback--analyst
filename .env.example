# =============================================================================
# Telegram Waiter — Environment Variables
# =============================================================================
# Copy this file to `.env` for local dev. For prod — use platform secrets
# (Fly secrets / Railway env / etc). NEVER commit a populated .env.
# =============================================================================

# --- Окружение ---
# local | staging | prod
ENV=local
LOG_LEVEL=INFO

# --- Telegram (два разных бота, отдельные токены) ---
# Создаются у @BotFather. Для local используем dev-боты (с суффиксом _dev в username).
TELEGRAM_GUEST_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_TOKEN=

# Bootstrap-токен для первого админа. Source of truth по админам — таблица
# `admin_users` в Supabase; этот токен используется ОДИН РАЗ при первой
# установке: владелец пишет admin-боту `/claim <ADMIN_BOOTSTRAP_TOKEN>`,
# его telegram_id пишется в admin_users, дальнейшая раздача прав — через
# /invite_admin внутри бота. Когда в admin_users появилась первая строка,
# этот токен перестаёт работать.
# Сгенерируй: openssl rand -hex 16
ADMIN_BOOTSTRAP_TOKEN=

# --- OpenAI (один ключ обслуживает chat + Whisper + Embeddings) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_EMBED_MODEL=text-embedding-3-small
# Тег для разделения биллинга/usage между окружениями
OPENAI_USAGE_TAG=local-dev

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX=client-cards
# Per-environment namespace: dev | staging | prod
PINECONE_NAMESPACE=dev

# --- Прочее ---
# Локальная папка для временных voice-файлов (auto-cleanup)
VOICE_TMP_DIR=./tmp/voice

# --- Контекст ресторана для voice question advisor ---
# Короткое описание заведения (1-3 фразы): тип кухни, аудитория, фишки.
# Используется как system-context при синтезе вопросов из голосового
# запроса админа. Пример: "Семейная пиццерия в центре, средний чек 800₽,
# дети до 12 — скидка, доставка через Яндекс.Еду."
RESTAURANT_CONTEXT=

# --- HTTP API (Phase 4A — admin Mini App backend) ---
# Frontend Mini App живёт в отдельном репозитории
# `telegram-waiter-admin-miniapp` (Phase 4C, инстанс из публичного template
# `telegram-miniapp-template` — Phase 4B). Этот backend = только тонкая
# HTTP-обёртка + auth поверх services/* и agent/*.
#
# Секрет для подписи admin JWT (issue после Telegram initData validation).
# Сгенерируй: openssl rand -hex 32
# Пустая строка = API в fail-loud режиме (issue/verify подымут RuntimeError).
MINI_APP_SESSION_SECRET=

# CORS allowlist для Mini App, comma-separated. Никогда не "*" — явный список.
# Для local dev: http://localhost:3000 (Next.js dev) + твой ngrok tunnel URL.
# Для prod: https://miniapp.<your-domain> или Vercel URL инстанса.
# Пример: http://localhost:3000,https://abcd-1234.ngrok-free.app
ALLOWED_MINI_APP_ORIGINS=
