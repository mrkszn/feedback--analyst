[Unit]
Description=Telegram Waiter — guest bot (aiogram polling)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=waiter
Group=waiter
WorkingDirectory=/opt/telegram-waiter
EnvironmentFile=/etc/telegram-waiter/.env
ExecStart=/opt/telegram-waiter/.venv/bin/python -m bot_guest
Restart=always
RestartSec=5
StandardOutput=append:/var/log/telegram-waiter/bot-guest.log
StandardError=append:/var/log/telegram-waiter/bot-guest.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/telegram-waiter/tmp /var/log/telegram-waiter

[Install]
WantedBy=multi-user.target
