[Unit]
Description=Telegram Waiter — FastAPI HTTP API (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=waiter
Group=waiter
WorkingDirectory=/opt/telegram-waiter
EnvironmentFile=/etc/telegram-waiter/.env
# Bind on 0.0.0.0 so the host-gateway address inside the Caddy container
# (docker0 bridge IP on the host) can reach us. Same pattern as the existing
# landing site on :8090. Public reachability of http://<vps-ip>:8200 should
# be blocked by ufw — see deploy/install-voice-api.sh for the rule.
ExecStart=/opt/telegram-waiter/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8200
Restart=always
RestartSec=5
StandardOutput=append:/var/log/telegram-waiter/voice-api.log
StandardError=append:/var/log/telegram-waiter/voice-api.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/telegram-waiter/tmp /var/log/telegram-waiter

[Install]
WantedBy=multi-user.target
